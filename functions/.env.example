# Copie para functions/.env e preencha. NUNCA suba o .env para o GitHub.
# String de conexão do MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/bombase?retryWrites=true&w=majority
# Para o servidor local (npm run dev) sem Firebase: aceita tokens "demo-ADMIN", "demo-RECEPCAO" etc.
AUTH_DEMO=false
PORT=5001
