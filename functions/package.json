{
  "name": "bombase-api",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,auth,hosting",
    "dev": "tsc && node --env-file=.env lib/src/dev-server.js",
    "seed": "tsc && node --env-file=.env lib/scripts/seed.js",
    "set-perfil": "tsc && node --env-file=.env lib/scripts/set-perfil.js",
    "test": "tsc && node --test \"lib/src/**/*.test.js\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.6.0",
    "mongoose": "^8.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "~5.7.2"
  }
}